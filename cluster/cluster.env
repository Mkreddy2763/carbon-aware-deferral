# Fill after running cluster/probe.sh. Sourced by every cluster script.
# Use the CPU partition: this paper needs no GPU. Never point this at a GPU partition.
export CS_PARTITION="cpu_faculty"   # CPU partition. Never a gpu_* partition; never --gres
export CS_ACCOUNT=""          # Slurm account, if the site requires -A
export CS_QOS=""              # QOS, if the site requires --qos
export CS_MAXTIME="12:00:00"  # single 128-core job; expected 0.5-1.5 h, generous cap, resumable
export CS_CPUS=64             # 128 blocked by the faculty account group limit (cpu=256 shared)
export CS_MEM="96G"           # ~0.3-0.5 GB per worker
export CS_MAX_ARRAY_PAR=8     # concurrent array tasks (respect MaxJobs per user)
export CS_ROOT="$HOME/carbonsched"   # repo + venv + data live here
export CS_VENV="$CS_ROOT/.venv"
export CS_MODULES=""          # e.g. "python/3.11" if the default python3 is < 3.10
export CS_PYTHON="python3"
# login-node proxy, if the campus network needs one
# export https_proxy=http://proxy.example:3128 http_proxy=$https_proxy
